{
  "name": "turbowarp-extension-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "lint": "eslint src tests vite.config.ts",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "check:dist": "npm run build && git diff --exit-code -- dist"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@kubohiroya/vite-plugin-turbowarp-extension": "github:kubohiroya/vite-plugin-turbowarp-extension#44a52a93fd1f7d9338c2b7acbf5ea5d3ebac90fc",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.0.0",
    "vitest": "^4.0.14"
  }
}
