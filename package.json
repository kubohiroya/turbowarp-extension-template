{
  "name": "@kubohiroya/turbowarp-extension-template",
  "version": "0.8.0",
  "description": "A reusable TypeScript template for developing TurboWarp extensions with Vite.",
  "author": {
    "name": "Hiroya Kubo",
    "email": "hiroya@cuc.ac.jp",
    "url": "https://github.com/kubohiroya"
  },
  "license": "MPL-2.0",
  "homepage": "https://github.com/kubohiroya/turbowarp-extension-template#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kubohiroya/turbowarp-extension-template.git"
  },
  "bugs": {
    "url": "https://github.com/kubohiroya/turbowarp-extension-template/issues"
  },
  "keywords": [
    "turbowarp",
    "scratch",
    "extension",
    "template",
    "vite",
    "typescript"
  ],
  "type": "module",
  "files": [
    "assets/",
    "dist/",
    "docs/",
    "src/",
    "lib-module/",
    "templates/",
    "README.md",
    "README.ja.md",
    "LICENSE",
    "samples/",
    "scripts/build-samples.mjs",
    "scripts/prepare-pages.mjs",
    "scripts/verify-samples.mjs"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "packageManager": "pnpm@11.28.8",
  "exports": {
    "./*": "./*",
    "./bundle-module": {
      "types": "./lib-module/bundle-module.d.ts",
      "import": "./lib-module/bundle-module.js"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "build": "vite build && pnpm run build:module",
    "build:module": "tsc -p tsconfig.module.json",
    "lint": "eslint src tests scripts vite.config.ts eslint.config.ts",
    "test": "vitest run",
    "docs": "node scripts/generate-readme.ts",
    "docs:check": "pnpm run docs && git diff --exit-code -- README.md",
    "template:readme": "node scripts/apply-readme-template.ts",
    "repo:check": "node scripts/check-repo.ts",
    "pack:check": "npm pack --dry-run --ignore-scripts",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run docs:check && pnpm run check:dist && pnpm run check:module && pnpm run repo:check && pnpm run pack:check && pnpm run samples:check",
    "check:module": "node scripts/check-bundle-module.ts",
    "check:dist": "pnpm run build && node scripts/check-dist.ts",
    "samples:build": "node scripts/build-samples.mjs",
    "samples:check": "node scripts/build-samples.mjs --check && node --test scripts/verify-samples.mjs",
    "pages:build": "node scripts/prepare-pages.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@kubohiroya/turbowarp-extension-manifest": "^0.5.0",
    "@kubohiroya/vite-plugin-turbowarp-extension": "^0.10.0",
    "@types/node": "^24.19.2",
    "eslint": "^9.39.5",
    "jiti": "^2.7.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "gitHead": "08635a33603e147513c98635b5b6aeb446963dbe",
  "x-turbowarp-source": {
    "revision": "08635a33603e147513c98635b5b6aeb446963dbe",
    "revisionRole": "base-commit",
    "sourceState": "local-release-overlay"
  }
}
